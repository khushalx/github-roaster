# Required: keep this server-side; never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional; this is the default for both single roasts and battles.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: HTML-tag verification token from Google Search Console.
# Use the token value only, not the full meta tag; redeploy after setting.
GOOGLE_SITE_VERIFICATION=
